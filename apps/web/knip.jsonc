{
  "$schema": "https://unpkg.com/knip@6.42.1/schema.json",
  // CI runs it directly (.github/workflows/ci.yml, the security job); nothing imports it. The npm
  // scripts' own scripts/*.mjs are found through package.json, from any checkout path (knip 6).
  "entry": ["scripts/audit-gate.mjs"],
  // A type used in its own file is kept exported: it is usually named in an exported signature,
  // and hiding it would make callers write ReturnType<…>. A value used only in its file is not.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  // Generated by scripts/build-tokens.mjs from tokens.json; changed there, never by hand.
  "ignore": ["src/design/tokens.ts"]
}
