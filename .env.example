# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Secrets belong in the platform's secret manager in deployed
# environments, never in this file and never in the repository.

# ---------------------------------------------------------------- application --
AIA_ENV=local                 # local | test | staging | production
AIA_DEBUG=false
AIA_LOG_LEVEL=INFO
AIA_LOG_FORMAT=console        # console for local readability, json in deployments

# ------------------------------------------------------------------- database --
# Matches docker-compose.yml. Production must use PostgreSQL; the API refuses to
# start in production with a SQLite URL.
DATABASE_URL=postgresql+psycopg://aia:aia_local_dev@localhost:5432/aia

# ---------------------------------------------------------------------- queue --
# There is no queue service, in any environment. PostgreSQL is both the
# authoritative store and the v0.1 queue: workers claim runnable steps with
# SELECT ... FOR UPDATE SKIP LOCKED. No Redis, no SQS. SQS may later be added as a
# non-authoritative wake-up, but only after a measured trigger and its own ADR --
# see docs/architecture/adr/0002-postgresql-authoritative-store.md.

# ----------------------------------------------------------- object storage ----
# Artifact blobs. Metadata lives in PostgreSQL; bytes live here. One definition,
# aia_core.infrastructure.storage_settings, read by the API and by the executors.
#   memory      tests only; vanishes with the process
#   filesystem  local development without Docker; AIA_STORAGE_ROOT
#   s3          S3 itself, or MinIO locally through AIA_STORAGE_ENDPOINT
# A deployed environment (AIA_ENV=staging|production) refuses anything but s3,
# and refuses an endpoint override. Credentials are never AIA settings: boto3
# reads AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY locally (MinIO's root user
# below) and the instance or task role in a deployment.
AIA_STORAGE_BACKEND=s3
AIA_STORAGE_BUCKET=aia-artifacts
AIA_STORAGE_REGION=eu-central-1
AIA_STORAGE_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=aia_local
AWS_SECRET_ACCESS_KEY=aia_local_dev

# ------------------------------------------------------------ build identity ---
# Set by the image build (deploy/develop, .github/workflows/deploy-develop.yml).
# /api/v1/health reports it and artifact provenance records it as the runtime
# version. Required in a deployed environment; leave unset locally.
# AIA_BUILD_SHA=
# AIA_BUILD_TIME=

# ------------------------------------------------------------- identity -------
# Authentication is Amazon Cognito federated to Google Workspace. There are no
# local AIA passwords.
#
# "development" trusts an X-AIA-Subject header so you can work without Cognito.
# It is refused outside local/test by two independent guards. Never set this to
# anything but "cognito" in a deployed environment.
AIA_IDENTITY_PROVIDER=development

# AIA_IDENTITY_PROVIDER=cognito
# AIA_COGNITO_REGION=eu-central-1
# AIA_COGNITO_USER_POOL_ID=eu-central-1_xxxxxxxxx
# AIA_COGNITO_CLIENT_ID=
# AIA_COGNITO_TOKEN_USE=id

# ------------------------------------------------------------------------ web --
# Empty means same-origin only, which is correct when one hostname serves both.
AIA_CORS_ORIGINS='["http://localhost:3000"]'

# ------------------------------------------------------------- AI providers ----
# Leave blank until a provider is actually needed. There is no silent fallback:
# a missing key parks work in a waiting state and asks the user.
#
# A key is not by itself permission to send anything. Client-derived material may
# only leave AIA over a route approved for its data class under the EU residency
# rules; the egress boundary fails closed, so an unconfigured deployment sends
# nothing at all. See docs/architecture/adr/0008-eu-data-residency.md.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------- migration reference ---
# Path to the NPC Panel prototype checkout. Enables the parity test suite, which
# compares this implementation against the validated prototype. Optional: the
# tests skip cleanly when it is unset.
AIA_LEGACY_REFERENCE=../npc-panel-reference
