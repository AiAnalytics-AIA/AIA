# Copy to .env for local development:  cp .env.example .env
# Never commit .env. Secrets belong in the platform's secret manager in deployed
# environments, never in this file and never in the repository.

# ---------------------------------------------------------------- application --
AIA_ENV=local                 # local | test | staging | production
AIA_DEBUG=false
AIA_LOG_LEVEL=INFO
AIA_LOG_FORMAT=console        # console for local readability, json in deployments

# ------------------------------------------------------------------- database --
# Matches docker-compose.yml. Production must use PostgreSQL; the API refuses to
# start in production with a SQLite URL.
DATABASE_URL=postgresql+psycopg://aia:aia_local_dev@localhost:5432/aia

# ---------------------------------------------------------------------- queue --
REDIS_URL=redis://localhost:6379/0

# ----------------------------------------------------------- object storage ----
# Artifact blobs. Metadata lives in PostgreSQL; bytes live here.
AIA_STORAGE_ENDPOINT=http://localhost:9000
AIA_STORAGE_BUCKET=aia-artifacts
AIA_STORAGE_ACCESS_KEY=aia_local
AIA_STORAGE_SECRET_KEY=aia_local_dev

# ------------------------------------------------------------------------ web --
# Empty means same-origin only, which is correct when one hostname serves both.
AIA_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------- AI providers ----
# Leave blank until a provider is actually needed. There is no silent fallback:
# a missing key parks work in a waiting state and asks the user.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ------------------------------------------------------- migration reference ---
# Path to the NPC Panel prototype checkout. Enables the parity test suite, which
# compares this implementation against the validated prototype. Optional: the
# tests skip cleanly when it is unset.
AIA_LEGACY_REFERENCE=../npc-panel-reference
