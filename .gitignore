# Dependencies
node_modules/
.venv/
venv/
*.egg-info/
__pycache__/
*.py[cod]

# Environment and secrets -- never commit these
.env
.env.*
!.env.example

# Local databases and scratch state
data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Build output
.next/
dist/
build/
openapi.json

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The NPC Panel prototype must never be committed here. It is a read-only
# reference kept beside this repository and pointed at by AIA_LEGACY_REFERENCE.
npc-panel-reference/
legacy_reference/

# The reference specification repository, checked out by CI for golden fixtures
# (and optionally locally). Fetched at a pinned commit, never committed here.
.reference/

# Test-run output: JUnit XML and parity-status reports
tmp/

# OS
.DS_Store

# Terraform: state and the tfvars file hold account ids and the Google client
# secret. The .example file is the only tfvars that is committed.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/terraform.tfvars
infra/**/.terraform.lock.hcl
