# Dependencies
node_modules/
.venv/
venv/
*.egg-info/
__pycache__/
*.py[cod]

# Environment and secrets -- never commit these
.env
.env.*
!.env.example

# Local databases and scratch state. Anchored to the repository root: the
# vendored legacy unit ships an app/data/ directory (provider_parity.json and
# the .gitkeep files its runtime expects) that an unanchored pattern would
# silently drop from every commit.
/data/
*.sqlite
*.sqlite-wal
*.sqlite-shm
*.db

# Build output
.next/
dist/
build/
openapi.json

# Tool caches
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/

# The raw NPC Panel archive and its extracted tree are never committed here;
# they are a read-only reference beside this repository, pointed at by
# AIA_LEGACY_REFERENCE. The *extracted product unit* is different: it lives at
# legacy/npc-panel-18.6.6/ by decision (ADR 0011) and is tracked.
npc-panel-reference/
legacy_reference/

# The reference specification repository, checked out by CI for golden fixtures
# (and optionally locally). Fetched at a pinned commit, never committed here.
.reference/

# Test-run output: JUnit XML and parity-status reports
tmp/

# OS
.DS_Store

# Terraform: state and the tfvars file hold account ids and the Google client
# secret. The .example file is the only tfvars that is committed.
infra/**/.terraform/
infra/**/*.tfstate
infra/**/*.tfstate.*
infra/**/terraform.tfvars
infra/**/.terraform.lock.hcl
