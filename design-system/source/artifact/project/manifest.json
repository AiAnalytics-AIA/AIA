  "components": [
    {
      "name": "StatusChip",
      "group": "Status",
      "summary": "Renders any domain status as a glyph plus a label in its tone."
    },
    {
      "name": "StatusGlyph",
      "group": "Status",
      "summary": "The 16-unit status glyph set: shape carries the state."
    },
    {
      "name": "EvidenceMark",
      "group": "Evidence",
      "summary": "The epistemic grade mark: ■ measured, ▣ calibrated, □ modelled, ⬚ holdout pending, ? unknown."
    },
    {
      "name": "Value",
      "group": "Evidence",
      "summary": "The one way a figure is rendered: value, zero, chybí, potlačeno or loading, with an optional evidence grade."
    },
    {
      "name": "EvidenceLegend",
      "group": "Evidence",
      "summary": "The persistent legend for the five evidence grades."
    },
    {
      "name": "Money",
      "group": "Money",
      "summary": "A monetary amount with its currency, in Czech formatting."
    },
    {
      "name": "Button",
      "group": "Actions",
      "summary": "Action buttons: primary (signal), secondary (bordered), quiet, danger; comfortable or compact."
    },
    {
      "name": "Kbd",
      "group": "Actions",
      "summary": "A keyboard shortcut hint."
    },
    {
      "name": "Icon",
      "group": "Identity",
      "summary": "The AIA icon set: 24 grid, 1.5 stroke, square caps."
    },
    {
      "name": "Mark",
      "group": "Identity",
      "summary": "The AIA mark: a 5 × 5 population lattice resolving into A, the apex in signal."
    },
    {
      "name": "Wordmark",
      "group": "Identity",
      "summary": "The AIA wordmark: the I is a column of five individuals."
    },
    {
      "name": "Lattice",
      "group": "Identity",
      "summary": "The motif as a deterministic dot field, for empty states and dividers."
    },
    {
      "name": "ScopeBar",
      "group": "Scope",
      "summary": "Persistent scope chrome: client accent band, monogram, client / study, study status, revision and role."
    },
    {
      "name": "ClientMonogram",
      "group": "Scope",
      "summary": "A client's two-letter monogram on its accent."
    },
    {
      "name": "StageRail",
      "group": "Lifecycle",
      "summary": "The thirteen-stage lifecycle rail and a project's primary navigation."
    },
    {
      "name": "RunTimeline",
      "group": "Lifecycle",
      "summary": "Honest progress: real elapsed time, heartbeat, real counts, the current step and what it waits on."
    },
    {
      "name": "ImpactPreview",
      "group": "Lifecycle",
      "summary": "Shows an edit's consequences before it is committed: kept vs reopened stages, artifacts kept, cost and time."
    },
    {
      "name": "BudgetMeter",
      "group": "Money",
      "summary": "A study budget: spent, uncertain (SETTLED_UNCERTAIN), reserved and remaining, each with an exact amount."
    },
    {
      "name": "ParkAndAsk",
      "group": "Money",
      "summary": "The spending-authorisation dialog when work parks on budget."
    },
    {
      "name": "ProviderChoice",
      "group": "Money",
      "summary": "An explicit choice when a provider cannot serve: wait (free) or switch (paid, changes provenance)."
    },
    {
      "name": "RecoveryDecision",
      "group": "Money",
      "summary": "RECOVERY_REQUIRED: a metered call may have been billed with an unknown outcome."
    },
    {
      "name": "UsageLedger",
      "group": "Money",
      "summary": "The immutable AI usage ledger: dense, sortable, attributable."
    },
    {
      "name": "ApprovalPanel",
      "group": "Review",
      "summary": "Gate approval and sign-off, including the separation-of-duties refusal."
    },
    {
      "name": "RevisionBanner",
      "group": "Lifecycle",
      "summary": "Marks that you are looking at a superseded revision."
    },
    {
      "name": "RevisionHistory",
      "group": "Lifecycle",
      "summary": "Immutable revision list with what each change reopened."
    },
    {
      "name": "HeadlineAnswer",
      "group": "Results",
      "summary": "The single sentence a client pays for, with its grade, n and interval, and the findings one level down."
    },
    {
      "name": "GradedBars",
      "group": "Results",
      "summary": "A bar chart whose bars carry their evidence grade, with direct labels."
    },
    {
      "name": "Sociomap",
      "group": "Results",
      "summary": "Respondent and object maps over immutable originals; view overrides and what-if are visible layers."
    },
    {
      "name": "ReportCover",
      "group": "Deliverable",
      "summary": "The Deliverable cover."
    },
    {
      "name": "ReportPage",
      "group": "Deliverable",
      "summary": "A Deliverable page: chapter, headline paragraph, holdout statement, evidence margin, figure, table and footnotes."
    },
    {
      "name": "Admin",
      "group": "Screens",
      "page": true
    },
    {
      "name": "CostBudget",
      "group": "Screens",
      "page": true
    },
