# The gate in front of the 18.6.6 reference unit (deploy/reference, ADR 0018).
#
# Plain HTTP on the host's loopback (docker-compose.yml publishes it on
# 127.0.0.1 only); anything further away reaches it through an SSM port
# forward, which is encrypted end to end. The unit has no authentication
# (AIA-reference high-risk-behaviors.md R14), so basic authentication here is
# not optional: tools/legacy_oracle.py refuses an ungated oracle, and a bare
# reverse_proxy to the unit may never replace this. The hash comes from
# `caddy hash-password`, stored in SSM like every secret.

{
	admin off
	auto_https off
}

:8765 {
	basic_auth {
		{$AIA_LEGACY_BASIC_USER} {$AIA_LEGACY_BASIC_HASH}
	}

	# The unit's own relay rewrites Host/Origin/Referer for its origin guard, so
	# nothing is rewritten here.
	reverse_proxy legacy-panel:8765

	log {
		output stdout
		format json
	}
}
