# /opt/aia/develop/.env -- the develop host's configuration.
#
# Written by bin/write-env.sh from SSM Parameter Store, owned root:root, mode
# 0600. Never committed, never in an image, never printed by a script. Values
# marked [ssm] are read from the parameter of that name under /aia/develop/;
# the rest are Terraform outputs copied in by the same script.

# --- images -------------------------------------------------------------------
# The ECR registry (Terraform output `ecr_registry`) and the git SHA being run.
# bin/deploy.sh rewrites AIA_IMAGE_TAG on every deployment; never a floating tag.
AIA_IMAGE_REGISTRY=123456789012.dkr.ecr.eu-central-1.amazonaws.com
AIA_IMAGE_TAG=0000000000000000000000000000000000000000

# --- host ----------------------------------------------------------------------
AIA_PUBLIC_HOSTNAME=dev.example.com
AIA_ACME_EMAIL=ops@example.com
AWS_REGION=eu-central-1
AIA_LOG_LEVEL=INFO

# --- database ------------------------------------------------------------------
# [ssm] /aia/develop/postgres_password  -- generated by Terraform, SecureString
POSTGRES_PASSWORD=

# --- storage -------------------------------------------------------------------
# Terraform outputs `artifacts_bucket`, `ops_bucket` (backups/ and deploy/ prefixes), `kms_key_id`.
AIA_STORAGE_BUCKET=aia-develop-artifacts-123456789012
AIA_STORAGE_PREFIX=
AIA_STORAGE_KMS_KEY_ID=
AIA_OPS_BUCKET=aia-develop-ops-123456789012

# --- identity ------------------------------------------------------------------
# Terraform outputs `cognito_user_pool_id`, `cognito_client_id`, `cognito_domain`.
# There is no client secret: the app client is public and uses PKCE.
AIA_COGNITO_USER_POOL_ID=eu-central-1_XXXXXXXXX
AIA_COGNITO_CLIENT_ID=
AIA_COGNITO_DOMAIN=aia-develop.auth.eu-central-1.amazoncognito.com

# --- worker --------------------------------------------------------------------
AIA_WORKER_LEASE_SECONDS=120
AIA_WORKER_HEARTBEAT_SECONDS=30
AIA_WORKER_POLL_SECONDS=2

# --- AI runtime (ADR 0010; aia_executors/ai_runtime.py) ----------------------
# Off unless AIA_AI_RUNTIME_ENABLED=true. When on, every key below without
# "optional" must be set, or the worker refuses to start. [ssm] each is
# /aia/develop/<lower_case_key>. No value here is a default: the model id is the
# one Terraform's bedrock_model_id grants; prices come from the Bedrock pricing
# page for eu-central-1 with the date recorded in ADR 0010; the two route flags
# are true only once ADR 0010's verification table records the human review.
AIA_AI_RUNTIME_ENABLED=false
AIA_AI_ROUTE_ID=bedrock-eu-primary
AIA_BEDROCK_REGION=eu-central-1
AIA_BEDROCK_MODEL_ID=
AIA_AI_POLICY_VERSION=
AIA_BEDROCK_INPUT_USD_PER_MTOK=
AIA_BEDROCK_OUTPUT_USD_PER_MTOK=
# optional: absent means cache tokens are charged at the input rate
AIA_BEDROCK_CACHE_READ_USD_PER_MTOK=
AIA_BEDROCK_CACHE_WRITE_USD_PER_MTOK=
AIA_BEDROCK_MAX_OUTPUT_TOKENS=
AIA_BEDROCK_CONTEXT_WINDOW_TOKENS=
# optional: the Converse read timeout in seconds, default 300
AIA_BEDROCK_TIMEOUT_SECONDS=
AIA_AI_ROUTE_EU_PROCESSING_APPROVED=false
AIA_AI_ROUTE_EXCLUDED_FROM_TRAINING=false
# Comma-separated DataClass values; empty = approved for nothing. ADR 0010: at
# most CLASS_C_INTERNAL until a reviewed change widens it.
AIA_AI_ROUTE_APPROVED_FOR=
# optional: leave unset. The account's Bedrock retention setting is "inherit",
# which is not an explicit zero; unset means "unspecified", which only Class C
# may travel with (ADR 0008).
AIA_AI_ROUTE_RETENTION_DAYS=
AIA_AI_FIELDWORK_MAX_OUTPUT_TOKENS=
# Budget held per respondent request (the primary call and one schema repair). The API reads
# this too: with the analysis reservation below it gives the most a run can cost, which the Run
# stage shows and a study's spend limit is checked against. Unset: that ceiling is unknown.
AIA_AI_FIELDWORK_RESERVATION_USD=
# Client ids do not classify design or prompt material; exact-content operator
# approvals are in AIA_AI_MATERIAL_CLASSIFICATIONS. The one thing this list does:
# the clients on which an administrator may try a DRAFT system prompt (ADR 0020).
# The API and the worker both read it; empty means no draft anywhere. Refused in production.
AIA_AI_FICTIONAL_CLIENT_IDS=
AIA_AI_MATERIAL_CLASSIFICATIONS=[]

# --- seed ----------------------------------------------------------------------
# The operator the idempotent seed provisions as organization owner. Must be the
# Google Workspace address that will sign in through Cognito.
AIA_SEED_OWNER_EMAIL=you@example.com

# --- the 18.6.6 reference unit (deploy/reference, ADR 0018) ---------------------
# Read by deploy/reference/bin/*, never by the product stack: nothing in
# docker-compose.yml, the Caddyfile or bin/ uses them. The gate in front of the
# reference unit is HTTP basic auth (the unit has no identity model of its own);
# AIA_LEGACY_BASIC_HASH is the output of `caddy hash-password`.
# [ssm] /aia/develop/aia_legacy_basic_hash -- SecureString
AIA_LEGACY_BASIC_USER=aia
AIA_LEGACY_BASIC_HASH=
# Where deploy/reference/bin/up.sh syncs the unit's licence-bound data bundle
# from (the `<dir>` of `extract_legacy.py --data-out`, uploaded once with
# `aws s3 sync <dir> s3://$AIA_OPS_BUCKET/$AIA_LEGACY_DATA_PREFIX/`).
AIA_LEGACY_DATA_PREFIX=legacy-data/86b70bfb5c1b
# An export of the unit's working databases (deploy/reference/bin/backup-state.sh)
# needs the data owner's approval; true says it was given.
AIA_LEGACY_STATE_BACKUP_ENABLED=false

# Native design/critique jobs, independently disabled until reviewed activation.
AIA_AI_RESEARCH_AGENTS_ENABLED=false
AIA_AI_ANALYSIS_ENABLED=false
AIA_AI_ANALYSIS_MAX_OUTPUT_TOKENS=
AIA_AI_ANALYSIS_RESERVATION_USD=
AIA_DEEP_RESEARCH_ENABLED=false
AIA_DEEP_RESEARCH_WIKIPEDIA_ENABLED=false
# Empty: Deep Research's agents do not think. An integer >= 1024 and below
# AIA_AI_RESEARCH_MAX_OUTPUT_TOKENS (thinking is part of that limit) turns it on.
AIA_DEEP_RESEARCH_THINKING_BUDGET_TOKENS=
AIA_AI_RESEARCH_MAX_OUTPUT_TOKENS=
# Must cover primary + one repair at configured model ceilings/prices.
AIA_AI_RESEARCH_RESERVATION_USD=
