# One hostname: the product, AIA (ADR 0015). Caddy terminates TLS with an ACME
# certificate it renews itself and redirects HTTP to HTTPS (its default when a
# site is named with a hostname).
#
# `/` answers 302 /app/clients, the React client-first application, behind AIA's
# own gate (ADR 0018). /api/v1/* goes to FastAPI, everything else to Next.js,
# whose own 404 answers a path it does not know. NPC Panel 18.6.6 is not served
# here in any form (ADR 0018 decisions 4 and 5): /classic is the web client's page
# saying so, and the unit's old paths (/api/bootstrap, /files/*, /health, ...)
# are the web client's 404 like any other unknown path. The unit, when a
# comparison needs it, runs from deploy/reference/ on the host's loopback behind
# its own gate; nothing here routes to it. One origin, so no CORS configuration
# exists.

{
	email {$AIA_ACME_EMAIL}
	# The admin endpoint stays on the loopback of the container; the compose
	# health check reads /metrics there. It is not published.
	admin 127.0.0.1:2019
	servers {
		metrics
	}
	# The default logger: Caddy's own entries, an upstream error among them, which records the
	# request's URI. docs.<hostname>'s ticket (/__aia/session?ticket=…) is left unspent when the
	# API is down, so it is never written here either (its access log filters it the same way).
	log {
		format filter {
			request>uri query {
				delete ticket
			}
			wrap json
		}
	}
}

{$AIA_PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The AIA API. Uvicorn runs with --proxy-headers and trusts this network, so
	# the client address and scheme it logs are the browser's. Only /api/v1: any
	# other /api/* path falls through to the web client's 404.
	handle /api/v1/* {
		# FastAPI reads a whole JSON body before authentication runs: bounded here,
		# above the largest upload (a 25 MiB file, base64 in JSON), a stranger cannot
		# make the API hold gigabytes before it answers 401 (tools/caddy_routes.py).
		request_body {
			max_size 40MiB
		}
		reverse_proxy api:8000 {
			header_up X-Request-Start {time.now.unix_ms}
		}
	}

	# AIA's own pages: the sign-in the gate sends people to, the live studies,
	# the build identity and Next.js's assets; AIA's self-hosted fonts and
	# identity under /skin/ (no data, public like /_next/*); and AIA's icon set.
	@web path /login /logout /auth/* /config /version /studies /studies/* /_next/* /skin/* /favicon.ico /icon.svg /apple-icon.png
	handle @web {
		reverse_proxy web:3000
	}

	# The product's front door (ADR 0015): the client directory. No gate here --
	# nothing is served -- /app puts AIA's gate in front of every page.
	handle / {
		# `*`: a first argument starting with / would be read as a path matcher.
		redir * /app/clients 302
	}

	# AIA, the React client-first application (ADR 0015), behind AIA's own gate
	# (ADR 0018 decision 3): any active member of an organization with an AIA
	# session; a navigation without one goes to /login. Nothing about the 18.6.6
	# unit decides it. The pages hold no data: they read /api/v1 with the person's
	# own token, where ScopeResolver authorizes every client and study again, per
	# call.
	@app path /app /app/*
	handle @app {
		route {
			forward_auth api:8000 {
				uri /api/v1/session/gate
			}
			reverse_proxy web:3000 {
				header_up -Cookie
			}
		}
	}

	# Everything else is AIA's: the web client answers, with its own 404 for a
	# path it does not know, the 18.6.6 unit's old paths among them.
	handle {
		reverse_proxy web:3000 {
			header_up -Cookie
		}
	}

	log {
		output stdout
		format json
	}
}

# GlitchTip, the error tracker (deploy/develop/errors, .planning/plans/error-tracking.md):
# its own name, so nothing of it shares AIA's origin, cookies or gate. GlitchTip has its
# own sign-in, and no one can register (an operator makes the accounts). Browsers send
# their events here; the API and the worker send theirs to glitchtip:8000 inside. When
# GlitchTip is not running this answers 502 and AIA is unaffected.
errors.{$AIA_PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	reverse_proxy glitchtip:8000

	log {
		output stdout
		format json
	}
}

# ONLYOFFICE Docs, Zpráva's report editor (deploy/develop/docs, plan report-editor-hosting):
# its own name, so its JavaScript never runs beside AIA's session token. Every request passes
# AIA's docs gate, which reads a docs-only cookie (never AIA's session), and the cookie stops
# here; the one way in is /__aia/session, where the API spends a one-time ticket and sets that
# cookie. The Document Server's server-to-server and admin paths are not served at all. Framed
# by AIA's pages alone. When the Document
# Server is not running this answers 502 and AIA is unaffected.
docs.{$AIA_PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Content-Security-Policy "frame-ancestors https://{$AIA_PUBLIC_HOSTNAME}"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# A ticket for the docs cookie: the API's, and nothing else of the API is served here.
	handle /__aia/session {
		rewrite * /api/v1/session/docs?{query}
		reverse_proxy api:8000
	}

	# Server to server (commands, conversion, the builder), its AI proxy, WOPI hosting and the
	# admin, info, welcome and example pages: nobody outside needs them, and AIA calls none of
	# them yet. Any case, with or without the version prefix its nginx strips
	# (/<a.b.c-d>/<path> reaches the same service), and with repeated slashes, which its nginx
	# merges.
	@server_only path_regexp server_only (?i)^/+(?:[0-9]+\.[0-9]+\.[0-9]+[.|-]\w+/+)?(?:coauthoring/+commandservice\.ashx|convertservice\.ashx|command|converter|docbuilder|ai-proxy|hosting|admin|info|internal|example|welcome|healthcheck)(?:[/?].*)?$
	handle @server_only {
		respond 404
	}

	handle {
		# Uploads into a document (an image), bounded like the API's.
		request_body {
			max_size 40MiB
		}
		route {
			forward_auth api:8000 {
				uri /api/v1/session/docs-gate
				# The gate answers a plain GET: an editor's WebSocket upgrade is not passed to it.
				header_up -Connection
				header_up -Upgrade
			}
			reverse_proxy onlyoffice:80 {
				header_up -Cookie
			}
		}
	}

	# The ticket is spent by the request that carries it, but a request that fails before the
	# spend would leave a live one in the log: the query's ticket is never written.
	log {
		output stdout
		format filter {
			request>uri query {
				delete ticket
			}
			wrap json
		}
	}
}
