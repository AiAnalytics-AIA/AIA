# Two hostnames. On both Caddy terminates TLS with an ACME certificate it renews
# itself and redirects HTTP to HTTPS (its default when a site is named with a
# hostname).
#
# The product hostname is the NPC Panel 18.6.6 interface, served by the vendored
# unit, with AIA in front of it (ADR 0012). /api/v1/* goes to FastAPI, AIA's own
# pages to Next.js, and everything else to the unit, but only after the API's
# gate has admitted the request: the unit has no identity model of its own.
# One origin, so no CORS configuration exists. When a feature is rebuilt on AIA,
# its legacy paths move from the last block to the API, and the ledger
# (docs/migration/legacy-route-ledger.json) records the move.
#
# The legacy hostname fronts the same unit behind HTTP basic authentication, as
# the parity oracle the harness reaches (ADR 0011).

{
	email {$AIA_ACME_EMAIL}
	# The admin endpoint stays on the loopback of the container; the compose
	# health check reads /metrics there. It is not published.
	admin 127.0.0.1:2019
	servers {
		metrics
	}
}

{$AIA_PUBLIC_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		# SAMEORIGIN, not DENY: the 18.6.6 interface shows its generated maps in
		# same-origin iframes (ADR 0012).
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The AIA API. Uvicorn runs with --proxy-headers and trusts this network, so
	# the client address and scheme it logs are the browser's. Only /api/v1: the
	# unit's own /api/* paths fall through to the last block.
	handle /api/v1/* {
		reverse_proxy api:8000 {
			header_up X-Request-Start {time.now.unix_ms}
		}
	}

	# AIA's own pages: the sign-in the gate sends people to, the live studies,
	# the build identity and Next.js's assets. No unit path collides with these.
	@web path /login /logout /auth/* /config /version /studies /studies/* /_next/*
	handle @web {
		reverse_proxy web:3000
	}

	# Everything else is the 18.6.6 unit, behind AIA sign-in. forward_auth asks
	# the gate first with the request's headers (cookie, Origin, Accept) and the
	# original method and URI; a 2xx lets the request through unchanged, and any
	# other answer (302 to /login, 401, 403) is returned to the browser as is.
	# The gate answers 404 when AIA_LEGACY_PANEL_ENABLED is off, so this block
	# then forwards nothing. The unit's relay rewrites Host/Origin/Referer for
	# its own origin guard, so nothing else is rewritten here.
	handle {
		forward_auth api:8000 {
			uri /api/v1/panel/gate
		}
		reverse_proxy legacy-panel:8765 {
			# The session cookie holds the user's id token and the unit reads no
			# cookie of its own, so none is passed on.
			header_up -Cookie
		}
	}

	log {
		output stdout
		format json
	}
}

{$AIA_LEGACY_HOSTNAME} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# The reference API has no authentication (AIA-reference
	# high-risk-behaviors.md R14). This gate is not optional; forward-auth to
	# Cognito may replace it later, a bare reverse_proxy may not. The hash is
	# produced by `caddy hash-password` and stored in SSM like every secret.
	basic_auth {
		{$AIA_LEGACY_BASIC_USER} {$AIA_LEGACY_BASIC_HASH}
	}

	# The unit's own relay rewrites Host/Origin/Referer for the reference's
	# origin guard, so nothing is rewritten here.
	reverse_proxy legacy-panel:8765

	log {
		output stdout
		format json
	}
}
