{
  "description": "The Lead's per-artifact contract (research-lead-workbench chunks 14-16, the hand-offs of artifact-chain-to-draft-report). One row per workbench stage, in STAGE_ORDER, every field required. It records which display operations the Lead may run on the artifact (view_ops), which of its elements it can name (targets, the `data-aia` id `<kind>:<id>` a screen puts on the element; the kind is everything before the first colon, and an id may itself hold colon-separated parts, e.g. `finding:<module>:<n>`), which workers and requests its cards start (starts), whether the Lead's edits land there (edits), what it is made from (inputs) and what it hands on, in what form (hands_off), and which internal report sections it feeds (report_sections, by the id the composer gives the Section). `live` marks what works today; anything else is the contract a screen builds to. Read by packages/aia_core/tests/test_lead_artifacts.py against domain/lead_artifacts.py and by apps/web/src/lib/workbench-artifacts.test.ts against lib/workbench-artifacts.ts, so a change to either side is a change to this file too.",
  "fields": [
    "stage",
    "artifact",
    "edits",
    "view_ops",
    "targets",
    "starts",
    "inputs",
    "hands_off",
    "report_sections",
    "refusals"
  ],
  "id_pattern": "[A-Za-z0-9_.\\-~/:]{1,80}",
  "view_ops": [
    {
      "op": "open_stage",
      "live": true,
      "what": "open the stage, optionally at a target"
    },
    {
      "op": "focus",
      "live": true,
      "what": "scroll to and highlight one target"
    },
    {
      "op": "inspect",
      "live": true,
      "what": "open a target's detail in the inspector (a claim, a step, a source, a readiness item)"
    },
    {
      "op": "select",
      "live": false,
      "what": "select an object or a pair on the map"
    },
    {
      "op": "filter",
      "live": false,
      "what": "a display filter, named; it changes no computation"
    },
    {
      "op": "show_diff",
      "live": false,
      "what": "show a waiting proposal's or a draft's changes against what is in force"
    }
  ],
  "filters": {
    "sociomap": [
      "view",
      "labels",
      "hide_weak",
      "mode",
      "battery"
    ]
  },
