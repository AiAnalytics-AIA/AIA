     "function": "deploy/docker/python.Dockerfile",
     "html": "<!doctype html><html><head><meta charset=utf8><meta name=viewport content=\"width=device-width,initial-scale=1,viewport-fit=cover\"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>\n<title>AIA Image Layers</title>\n<meta name=\"claude:viewport-fit-sides\" content=\"cover\">\n<style>\n/* Layout: one 360px-tall card: step caption, two layer stacks (before | after), controls row. Self-contained, no external requests. */\n:root {\n  --bg: #f3f5f7; --fg: #17202a; --muted: #5b6672; --line: #d5dbe1;\n  --cached: #c9dbe0; --cached-ink: #24525e; --rebuilt: #e9873a; --rebuilt-ink: #ffffff;\n  --meta: #e6e9ed; --meta-ink: #5b6672; --accent: #1f6f82;\n  --sans: system-ui, -apple-system, \"Segoe UI\", sans-serif;\n  --mono: ui-monospace, \"SFMono-Regular\", Menlo, Consolas, monospace;\n}\n@media (prefers-color-scheme: dark) { :root:not([data-theme=\"light\"]) {\n  --bg: #12171c; --fg: #e4e9ee; --muted: #98a3ae; --line: #2c353e;\n  --cached: #24414a; --cached-ink: #bfe0e8; --rebuilt: #d9772c; --rebuilt-ink: #12171c;\n  --meta: #232b33; --meta-ink: #98a3ae; --accent: #6cc0d2; color-scheme: dark } }\n:root[data-theme=\"dark\"] {\n  --bg: #12171c; --fg: #e4e9ee; --muted: #98a3ae; --line: #2c353e;\n  --cached: #24414a; --cached-ink: #bfe0e8; --rebuilt: #d9772c; --rebuilt-ink: #12171c;\n  --meta: #232b33; --meta-ink: #98a3ae; --accent: #6cc0d2; color-scheme: dark }\nhtml, body { height: 100%; }\nbody { background: var(--bg); color: var(--fg); font: 13px/1.4 var(--sans); margin: 0;\n  padding-left: max(12px, env(safe-area-inset-left, 0px)); padding-right: max(12px, env(safe-area-inset-right, 0px)); padding-block: 10px; box-sizing: border-box; }\nmain { height: 340px; max-height: 100%; display: grid; grid-template-rows: auto 1fr auto; gap: 8px; max-width: 900px; margin: 0 auto; }\n.step { min-height: 4.2em; }\n.step .n { font: 600 10px var(--mono); letter-spacing: .08em; text-transform: uppercase; color: var(--accent); }\n.step p { margin: 2px 0 0; }\ncode { font-family: var(--mono); font-size: .92em; }\n.stacks { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; min-height: 0; }\n.stack { display: flex; flex-direction: column; gap: 3px; min-width: 0; }\n.stack h2 { font: 600 10px var(--sans); letter-spacing: .08em; text-transform: uppercase; color: var(--muted); margin: 0; }\n.layer { display: flex; justify-content: space-between; gap: 6px; align-items: center; border-radius: 3px; padding: 3px 7px;\n  background: var(--cached); color: var(--cached-ink); font-size: 11.5px; transition: background .35s, color .35s, opacity .35s; min-width: 0; }\n.layer .name { min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }\n.layer .size { font-family: var(--mono); font-size: 10.5px; white-space: nowrap; font-variant-numeric: tabular-nums; }\n.layer.big { padding-block: 14px; } .layer.mid { padding-block: 8px; }\n.layer.meta { background: var(--meta); color: var(--meta-ink); outline: 1px dashed var(--line); outline-offset: -1px; }\n.layer.rebuilt { background: var(--rebuilt); color: var(--rebuilt-ink); }\n.layer.dim { opacity: .35; }\n.total { font: 11px var(--mono); font-variant-numeric: tabular-nums; min-height: 1.4em; margin-top: 2px; }\n.total b { color: var(--rebuilt); }\n.bar { display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; }\nbutton { font: 600 12px var(--sans); background: transparent; color: var(--fg); border: 1px solid var(--line); border-radius: 5px; padding: 4px 10px; cursor: pointer; }\nbutton:hover { border-color: var(--accent); }\nbutton:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }\nbutton:disabled { opacity: .45; cursor: default; }\n.dots { display: flex; gap: 4px; }\n.dots i { width: 7px; height: 7px; border-radius: 50%; background: var(--line); }\n.dots i.on { background: var(--accent); }\n.legend { display: flex; gap: 10px; flex-wrap: wrap; color: var(--muted); font-size: 11px; margin-left: auto; }\n.legend span::before { content: \"\"; display: inline-block; width: 9px; height: 9px; border-radius: 2px; margin-right: 4px; background: var(--sw); }\n@media (max-width: 480px) { .legend { display: none; } .layer .name { white-space: normal; } }\n@media (prefers-reduced-motion: reduce) { .layer { transition: none; } }\n</style>\n\n<main>\n  <div class=\"step\" aria-live=\"polite\"><div class=\"n\" id=\"stepn\"></div><p id=\"stept\"></p></div>\n\n  <div class=\"stacks\">\n    <section class=\"stack\" aria-label=\"Before\">\n      <h2>Before: worker image</h2>\n      <div class=\"layer meta\" data-b=\"sha\" title=\"Declared at the top of the runtime stage\"><span class=\"name\"><code>ARG AIA_BUILD_SHA</code> at top</span><span class=\"size\">no layer</span></div>\n      <div class=\"layer mid\" data-b=\"lo\"><span class=\"name\">LibreOffice Writer</span><span class=\"size\">≈300 MB*</span></div>\n      <div class=\"layer big\" data-b=\"venv\"><span class=\"name\">/opt/venv: deps + AIA code</span><span class=\"size\">772 MB</span></div>\n      <div class=\"layer\" data-b=\"user\"><span class=\"name\">user aia (RUN)</span><span class=\"size\">45 kB</span></div>\n      <div class=\"layer\" data-b=\"base\"><span class=\"name\">python:3.12-slim</span><span class=\"size\">base</span></div>\n      <div class=\"total\" id=\"tb\"></div>\n    </section>\n    <section class=\"stack\" aria-label=\"After\">\n      <h2>After: worker image</h2>\n      <div class=\"layer meta\" data-a=\"sha\" title=\"Set at the end of the target\"><span class=\"name\"><code>ARG AIA_BUILD_SHA</code> last</span><span class=\"size\">no layer</span></div>\n      <div class=\"layer\" data-a=\"code\"><span class=\"name\">AIA packages, --no-deps</span><span class=\"size\">19.7 MB</span></div>\n      <div class=\"layer mid\" data-a=\"lo\"><span class=\"name\">LibreOffice Writer</span><span class=\"size\">≈300 MB*</span></div>\n      <div class=\"layer big\" data-a=\"venv\"><span class=\"name\">/opt/venv: third-party only</span><span class=\"size\">772 MB</span></div>\n      <div class=\"layer\" data-a=\"user\"><span class=\"name\">user aia (RUN)</span><span class=\"size\">45 kB</span></div>\n      <div class=\"layer\" data-a=\"base\"><span class=\"name\">python:3.12-slim</span><span class=\"size\">base</span></div>\n      <div class=\"total\" id=\"ta\"></div>\n    </section>\n  </div>\n\n  <div class=\"bar\">\n    <button id=\"prev\" type=\"button\">Back</button>\n    <button id=\"play\" type=\"button\">Play</button>\n    <button id=\"next\" type=\"button\">Step</button>\n    <div class=\"dots\" id=\"dots\" aria-hidden=\"true\"></div>\n    <div class=\"legend\">\n      <span style=\"--sw: var(--cached)\">cached</span>\n      <span style=\"--sw: var(--rebuilt)\">rebuilt, downloaded</span>\n    </div>\n  </div>\n</main>\n\n<script>\nconst steps = [\n  { t: \"The worker image as the last deploy built it, before and after the split in deploy/docker/python.Dockerfile. Every layer is already on the develop host.\", b: {}, a: {} },\n  { t: \"A commit changes one line of AIA's source. No pyproject.toml, no dependency changes.\", b: {}, a: {} },\n  { t: \"Before: sources were copied in before pip install, so the edit re-runs the whole install (4 m 30 s). After: the deps stage reads only the pyproject files and is reused.\", b: { venv: \"rebuilt\" }, a: {}, tb: \"pip install re-runs\", ta: \"deps reused\" },\n  { t: \"Before: AIA_BUILD_SHA sat in every RUN's environment, so a new SHA rebuilt the user RUN and everything above it, LibreOffice too. After: the SHA is set last.\", b: { sha: \"on\", user: \"rebuilt\", venv: \"rebuilt\", lo: \"rebuilt\" }, a: { sha: \"on\" } },\n  { t: \"After: only AIA's own four packages install again, in a small layer above LibreOffice.\", b: { sha: \"on\", user: \"rebuilt\", venv: \"rebuilt\", lo: \"rebuilt\" }, a: { sha: \"on\", code: \"rebuilt\" } },\n  { t: \"New on the host per deploy (unpacked; measured 2026-10-20). *LibreOffice's size is the Dockerfile's estimate; it could not be built in the measuring sandbox.\", b: { sha: \"on\", user: \"rebuilt\", venv: \"rebuilt\", lo: \"rebuilt\" }, a: { sha: \"on\", code: \"rebuilt\" }, tb: \"new: <b>≈1.1 GB</b>\", ta: \"new: <b>≈40 MB</b> (api + worker)\" },\n];\nlet i = 0, timer = null;\nconst $ = (s) => document.querySelector(s);\nconst dots = $(\"#dots\");\nsteps.forEach(() => dots.appendChild(document.createElement(\"i\")));\nfunction paint(side, state) {\n  document.querySelectorAll(`[data-${side}]`).forEach((el) => {\n    const s = state[el.dataset[side]];\n    el.classList.toggle(\"rebuilt\", s === \"rebuilt\");\n    if (el.classList.contains(\"meta\")) el.classList.toggle(\"dim\", s !== \"on\");\n  });\n}\nfunction render() {\n  const s = steps[i];\n  $(\"#stepn\").textContent = `Step ${i + 1} of ${steps.length}`;\n  $(\"#stept\").textContent = s.t;\n  paint(\"b\", s.b); paint(\"a\", s.a);\n  $(\"#tb\").innerHTML = s.tb || \"\"; $(\"#ta\").innerHTML = s.ta || \"\";\n  [...dots.children].forEach((d, k) => d.classList.toggle(\"on\", k === i));\n  $(\"#prev\").disabled = i === 0; $(\"#next\").disabled = i === steps.length - 1;\n}\nfunction stop() { clearInterval(timer); timer = null; $(\"#play\").textContent = \"Play\"; }\n$(\"#next\").onclick = () => { stop(); if (i < steps.length - 1) { i++; render(); } };\n$(\"#prev\").onclick = () => { stop(); if (i > 0) { i--; render(); } };\n$(\"#play\").onclick = () => {\n  if (timer) return stop();\n  if (i === steps.length - 1) i = 0;\n  render(); $(\"#play\").textContent = \"Pause\";\n  timer = setInterval(() => { if (i < steps.length - 1) { i++; render(); } else stop(); }, 3500);\n};\nrender();\n</script>\n\n</body></html>"
