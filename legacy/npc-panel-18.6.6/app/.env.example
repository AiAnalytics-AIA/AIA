# NPC Panel local configuration
# START_NPC creates .env from this template. Fill only what you need.

# Preferred AI provider for survey/orchestration. Example: sk-ant-...
ANTHROPIC_API_KEY=

# Optional alternative provider. LIVE never switches to it automatically; switching requires explicit user approval.
OPENAI_API_KEY=

# Optional Anthropic model overrides. Defaults follow Anthropic's current lineup and
# are checked against the models your account can actually see; a retired ID is
# substituted automatically. Pin an ID here when you need reproducible runs.
# NPC_ANTHROPIC_HAIKU_MODEL=claude-haiku-4-5-20251001
# NPC_ANTHROPIC_SONNET_MODEL=claude-sonnet-5
# NPC_ANTHROPIC_OPUS_MODEL=claude-opus-5
# NPC_ANTHROPIC_RESEARCH_MODEL=claude-sonnet-5

# Optional OpenAI fallback/research model.
# NPC_OPENAI_RESEARCH_MODEL=gpt-5

# Optional custom Anthropic gateway. Do not set ANTHROPIC_BASE_URL accidentally;
# NPC ignores it unless you explicitly opt in here.
# NPC_ANTHROPIC_BASE_URL=https://api.anthropic.com
# NPC_OPENAI_BASE_URL=

# Machine-level variables NPC deliberately ignores while calling a provider,
# because they override an explicit API key and cause a 401 that looks like a
# wrong key: ANTHROPIC_AUTH_TOKEN, ANTHROPIC_PROFILE, ANTHROPIC_BASE_URL,
# OPENAI_BASE_URL. Settings -> Diagnostika AI reports them if present.


# Production safety: never invent research/scenario content locally when Claude fails.
NPC_ALLOW_LOCAL_DESIGN_FALLBACK=0
NPC_ALLOW_LOCAL_SCENARIO_FALLBACK=0

# Optional production panel override.
# NPC_PANEL=C:\path\to\FINALNI_KOMPLETNI_PANEL_v15_2_1.csv

# Optional run output directory.
# NPC_RUNS=runs
