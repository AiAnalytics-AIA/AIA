# syntax=docker/dockerfile:1.7
#
# NPC Panel 18.6.6 -- extracted product, as one deployable unit.
#
# Generated by AIA-reference/tools/extract_legacy.py. The code tree (app/) is
# baked into the image; the licence-bound data (data-manifest.json) is mounted
# at /data and hydrated into the working tree at start. Build from this
# directory:
#
#   docker build -t aia-legacy-panel:<sha> legacy/npc-panel-18.6.6
#
ARG PYTHON_VERSION=3.13
FROM python:${PYTHON_VERSION}-slim-bookworm

ARG AIA_BUILD_SHA
ENV AIA_BUILD_SHA=${AIA_BUILD_SHA} \
    PYTHONUNBUFFERED=1 PYTHONUTF8=1 PYTHONIOENCODING=utf-8 PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1 LANG=C.UTF-8

RUN apt-get update \
 && apt-get install -y --no-install-recommends tini ca-certificates procps \
 && rm -rf /var/lib/apt/lists/*

COPY runtime/requirements-runtime.txt /opt/npc/requirements-runtime.txt
RUN pip install -r /opt/npc/requirements-runtime.txt && pip freeze > /opt/npc/pip-freeze.txt

COPY runtime/ /opt/npc/
COPY app-manifest.json data-manifest.json runtime-assets.SHA256SUMS.txt /opt/npc/manifests/
COPY app/ /opt/npc/tree/
RUN chmod 0755 /opt/npc/entrypoint.sh \
 && groupadd --system --gid 10001 aia \
 && useradd --system --uid 10001 --gid aia --home-dir /app --shell /usr/sbin/nologin aia \
 && mkdir -p /app /data && chown aia:aia /app

USER aia
WORKDIR /app
VOLUME ["/app"]

ENV NPC_TREE=/app \
    NPC_TREE_SOURCE=/opt/npc/tree \
    NPC_DATA_SOURCE=/data \
    NPC_DATA_MANIFEST=/opt/npc/manifests/data-manifest.json \
    NPC_REFERENCE_META=/opt/npc/manifests \
    NPC_SUMS_FILE=runtime-assets.SHA256SUMS.txt \
    NPC_INVENTORY_FILE=app-manifest.json \
    NPC_PUBLIC_PORT=8765 NPC_PORT_SCAN=8765-8785 \
    NPC_VERIFY=strict NPC_TREE_SEED=once NPC_START_WORKER=1 NPC_STARTUP_TIMEOUT_S=120

EXPOSE 8765
HEALTHCHECK --interval=15s --timeout=5s --start-period=120s --retries=5 \
  CMD ["python3", "/opt/npc/healthcheck.py"]
ENTRYPOINT ["tini", "--", "/opt/npc/entrypoint.sh"]
CMD ["start"]
